<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="RobotComposition" Id="{00b893f1-df08-5397-861a-dcbcde94bdb4}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'Use the methods of this class'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK RobotComposition
VAR
	simulator : SimulatorLink;
	leftAxis : DriveAxis_Nc(ncAxis := Axes.leftWheel);
	rightAxis : DriveAxis_Nc(ncAxis := Axes.rightWheel);
	simulatedGyro : Gyro_Simulated(simulator := simulator);
	simulatedAccelerometer : Accelerometer_Simulated(simulator := simulator);
	simulatedLidar : Lidar_Simulated(simulator := simulator);
	simulatedLidarPower : DigitalOut_SimulatedLidarPower;

	gyro : I_Gyro;
	accelerometer : I_Accelerometer;
	lidarPower : I_DigitalOut;
	lidar : Lidar_Watchdog;
	drive : DiffDrive;
	odometry : WheelOdometry;
	gyroOdometry : GyroOdometry;
	mission : SweepMission;

	scan : LaserScan;
	requestedPose : Pose2D;
	isInitialized : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Execute" Id="{9147f99d-0110-5b6e-80e6-1ee328a5f45f}">
      <Declaration><![CDATA[METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT isInitialized THEN
	Initialize();
END_IF

IF Parameters.platform = PlatformKind.SIMULATION THEN
	simulator.Execute();
END_IF

lidar.Execute();
IF lidar.TryGetScan(scan) THEN
	// Kommer i M3 og M4: kartoppdatering og scan matching.
	;
END_IF

odometry.Execute();
gyroOdometry.Execute();
mission.Execute();
IF mission.TryTakePoseRequest(requestedPose) THEN
	odometry.Reset(requestedPose);
	gyroOdometry.Reset(requestedPose);
END_IF

IF mission.ShouldDrive THEN
	drive.Enable();
	drive.SetTwist(mission.DesiredTwist);
ELSE
	drive.Disable();
END_IF
drive.Execute();

IF Parameters.platform = PlatformKind.SIMULATION THEN
	SendWheelsToSimulator();
END_IF

PublishStatus();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{23fcb38d-200f-5401-b791-75ecff777860}">
      <Declaration><![CDATA[METHOD PRIVATE Initialize
VAR
	start : Pose2D;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Parameters.platform OF
	PlatformKind.SIMULATION:
		gyro := simulatedGyro;
		accelerometer := simulatedAccelerometer;
		lidar.Wrap(simulatedLidar);
		lidarPower := simulatedLidarPower;
	PlatformKind.HARDWARE:
		// Kommer i M7: Gyro_EP3751 og valgt LIDAR-adapter. Hjulene bruker de samme NC-aksene.
		RETURN;
END_CASE

drive.Connect(leftAxis, rightAxis);

lidarPower.SwitchOn();
lidar.Start();
odometry.Connect(drive);
odometry.Reset(start);
gyroOdometry.Connect(drive, gyro);
gyroOdometry.Reset(start);
isInitialized := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendWheelsToSimulator" Id="{8f10f9af-3837-5fb5-8260-2457f9c12315}">
      <Declaration><![CDATA[METHOD PRIVATE SendWheelsToSimulator]]></Declaration>
      <Implementation>
        <ST><![CDATA[// I simuleringen er NC-aksene motor og enkoder. Simulatoren får vite hvor langt hjulene faktisk har gått,
// lar de simulerte hjulene følge det nøyaktig, og flytter roboten etter det, med sluring og kollisjoner.
SimulatorIo.command.leftWheelVelocityInMPerS := leftAxis.VelocityInMPerS;
SimulatorIo.command.rightWheelVelocityInMPerS := rightAxis.VelocityInMPerS;
SimulatorIo.command.leftWheelPositionInM := leftAxis.PositionInM;
SimulatorIo.command.rightWheelPositionInM := rightAxis.PositionInM;
SimulatorIo.command.isLeftDriveEnabled := leftAxis.IsReady;
SimulatorIo.command.isRightDriveEnabled := rightAxis.IsReady;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishStatus" Id="{7cd620cb-62be-5d54-820f-dc5c4cebc267}">
      <Declaration><![CDATA[METHOD PRIVATE PublishStatus
VAR
	lidarError : HardwareError;
	estimate : Pose2D;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Parameters.useGyroForHeading THEN
	estimate := gyroOdometry.Pose;
ELSE
	estimate := odometry.Pose;
END_IF

lidarError := lidar.Error;
RobotHmi.status.estimatedPose := estimate;
RobotHmi.status.isSimulatorConnected := simulator.IsConnected;
RobotHmi.status.isLidarOk := NOT lidarError.isActive;
SimulatorIo.command.estimatedPose := estimate;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
