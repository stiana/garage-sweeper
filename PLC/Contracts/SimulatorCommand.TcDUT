<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <DUT Name="SimulatorCommand" Id="{ef5ef6ff-8903-5410-9bba-2c75dd95eb39}">
    <Declaration><![CDATA[TYPE SimulatorCommand :
STRUCT
	version : UDINT;
	cycle : UDINT;
	plcTimeInNs : ULINT;
	// The wheels' actual speed and position, from the NC axes. The simulated wheels run at
	// the speed and are nudged towards the position, so they never drift away from NC.
	leftWheelVelocityInMPerS : LREAL;
	rightWheelVelocityInMPerS : LREAL;
	leftWheelPositionInM : LREAL;
	rightWheelPositionInM : LREAL;
	isLeftDriveEnabled : BOOL;
	isRightDriveEnabled : BOOL;
	isLidarPowered : BOOL;
	estimatedPose : Pose2D;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
