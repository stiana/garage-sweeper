<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="Parameters" Id="{1597954a-e0f8-5851-b29a-c1b34e85d36f}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	platform : PlatformKind := PlatformKind.SIMULATION;
	// Hjulradien ligger i NC-skaleringen av aksene, som går i meter langs hjulbanen.
	trackWidthInM : LREAL := 0.40;
	maxWheelSpeedInMPerS : LREAL := 0.6;
	// Hvor fort hjulene får endre fart. Uten disse bruker NC sine standardverdier, og hjulene
	// stopper fra full fart på et par hundredeler, mye brattere enn en ekte robot tåler uten å skli.
	wheelAccelerationInMPerS2 : LREAL := 1.0;
	wheelJerkInMPerS3 : LREAL := 10.0;
	useGyroForHeading : BOOL := FALSE;
	gyroScale : LREAL := 1.0;

	// Hvor lidaren sitter på roboten, sett fra midt mellom hjulene (x fram, y mot venstre),
	// og hvor mye den er dreid. I simulatoren står den midt mellom hjulene og peker rett fram.
	lidarMountXInM : LREAL := 0.0;
	lidarMountYInM : LREAL := 0.0;
	lidarMountThetaInRad : LREAL := 0.0;

	// Kartet. Origo er hjørnet til celle [0, 0]; med -3.4 dekker kartet en garasje på 6 x 6 m med god margin.
	mapCellSizeInM : LREAL := 0.05;
	mapOriginXInM : LREAL := -3.4;
	mapOriginYInM : LREAL := -3.4;
	// Log-odds i tideler (Constants.MAP_LOG_ODDS_PER_UNIT): treff +0.9, fri -0.4, aldri mer enn ±3.5.
	mapHitLogOdds : SINT := 9;
	mapFreeLogOdds : SINT := -4;
	mapMaxLogOdds : SINT := 35;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>