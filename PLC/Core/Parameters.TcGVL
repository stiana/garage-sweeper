<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <GVL Name="Parameters" Id="{1597954a-e0f8-5851-b29a-c1b34e85d36f}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	platform : PlatformKind := PlatformKind.SIMULATION;
	// Hjulradien ligger i NC-skaleringen av aksene, som går i meter langs hjulbanen.
	trackWidthInM : LREAL := 0.40;
	maxWheelSpeedInMPerS : LREAL := 0.6;
	// Hvor fort hjulene får endre fart. Uten disse bruker NC sine standardverdier, og hjulene
	// stopper fra full fart på et par hundredeler, mye brattere enn en ekte robot tåler uten å skli.
	wheelAccelerationInMPerS2 : LREAL := 1.0;
	wheelJerkInMPerS3 : LREAL := 10.0;
	useGyroForHeading : BOOL := FALSE;
	// Gyroens skalafaktor: GyroOdometry ganger målt rotasjon (etter bias) med denne.
	// Finn den med «Kalibrer gyro» i GUI-en, og gang den gamle verdien med faktoren den viser.
	gyroScale : LREAL := 1.0;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
