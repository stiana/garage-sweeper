<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GyroOdometry" Id="{8b93f923-f0b6-444c-827c-2003794c8377}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'Use the methods of this class'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK GyroOdometry IMPLEMENTS I_PoseSource
VAR
	drive : I_DifferentialDrive;
	gyro : I_Gyro;
	kinematics : DiffDriveKinematics;
	_pose : Pose2D;
	lastLeftInM : LREAL;
	lastRightInM : LREAL;
	lastGyroTimestampInNs : ULINT;
	gyroBiasInRadPerS : LREAL;
	standStillTimer : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Connect" Id="{f3c0a70e-f313-4e6b-9893-d65ac388a212}">
      <Declaration><![CDATA[METHOD Connect
VAR_INPUT
	differentialDrive : I_DifferentialDrive;
	yawGyro : I_Gyro;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[drive := differentialDrive;
gyro := yawGyro;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{f7dc8dcb-2189-4204-bcd1-7a9237aa0207}">
      <Declaration><![CDATA[METHOD Execute
VAR
	leftInM : LREAL;
	rightInM : LREAL;
	motion : BodyMotion;
	midHeadingInRad : LREAL;
	headingChangeInRad : LREAL;
	dtInS : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Strekning fra hjulene
leftInM := drive.LeftWheelPositionInM;
rightInM := drive.RightWheelPositionInM;
motion := kinematics.ToBodyMotion(leftDeltaInM := leftInM - lastLeftInM, rightDeltaInM := rightInM - lastRightInM);
lastLeftInM := leftInM;
lastRightInM := rightInM;

standStillTimer(IN := drive.IsStandingStill, PT := T#500MS);
// Kursendring fra gyroen, bare når det har kommet en ny måling
IF gyro.IsValid AND gyro.TimestampInNs <> lastGyroTimestampInNs THEN
	IF gyro.TimestampInNs > lastGyroTimestampInNs THEN
		dtInS := ULINT_TO_LREAL(gyro.TimestampInNs - lastGyroTimestampInNs) * 1E-9;
	END_IF
	IF dtInS > 0 AND dtInS < 0.5 THEN
		headingChangeInRad := (gyro.YawRateInRadPerS - gyroBiasInRadPerS) * dtInS;
	END_IF
	
	IF standStillTimer.Q THEN
		gyroBiasInRadPerS := gyroBiasInRadPerS + 0.01 * (gyro.YawRateInRadPerS - gyroBiasInRadPerS);
		headingChangeInRad := 0;
	END_IF
	
	lastGyroTimestampInNs := gyro.TimestampInNs;
END_IF

// Flytt roboten, med kursen midt i steget
midHeadingInRad := _pose.thetaInRad + headingChangeInRad / 2.0;
_pose.x := _pose.x + motion.distanceInM * COS(midHeadingInRad);
_pose.y := _pose.y + motion.distanceInM * SIN(midHeadingInRad);
_pose.thetaInRad := _pose.thetaInRad + headingChangeInRad;

IF _pose.thetaInRad > PI THEN
	_pose.thetaInRad := _pose.thetaInRad - 2.0 * PI;
ELSIF _pose.thetaInRad <= -PI THEN
	_pose.thetaInRad := _pose.thetaInRad + 2.0 * PI;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Pose" Id="{1fff3854-2fa4-4b06-b641-916fbe1f17b0}">
      <Declaration><![CDATA[PROPERTY Pose : Pose2D]]></Declaration>
      <Get Name="Get" Id="{98fdd20b-942a-4448-9c1a-9380a4f1130e}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Pose := _pose;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{29d4f7cf-2782-452f-a1c6-438de4fef24c}">
      <Declaration><![CDATA[METHOD Reset
VAR_INPUT
	pose : Pose2D;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pose := pose;
lastLeftInM := drive.LeftWheelPositionInM;
lastRightInM := drive.RightWheelPositionInM;
lastGyroTimestampInNs := gyro.TimestampInNs;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>