<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="DiffDrive" Id="{0bbf6c55-3be5-53ce-af2a-579f36f57573}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'Use the methods of this class'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK DiffDrive IMPLEMENTS I_DifferentialDrive
VAR
	leftAxis : I_DriveAxis;
	rightAxis : I_DriveAxis;
	kinematics : DiffDriveKinematics;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Connect" Id="{097fee2a-ff23-58d4-b286-94e459e4269d}">
      <Declaration><![CDATA[METHOD Connect
VAR_INPUT
	left : I_DriveAxis;
	right : I_DriveAxis;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[leftAxis := left;
rightAxis := right;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{faac4bfe-0ce8-591b-9cf4-3ce387f54fd0}">
      <Declaration><![CDATA[METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF leftAxis = 0 OR rightAxis = 0 THEN
	RETURN;
END_IF
leftAxis.Execute();
rightAxis.Execute();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Enable" Id="{baa38bb0-278d-5e8a-871b-b137239c7090}">
      <Declaration><![CDATA[METHOD Enable]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF leftAxis = 0 OR rightAxis = 0 THEN
	RETURN;
END_IF
leftAxis.Enable();
rightAxis.Enable();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Disable" Id="{486dcacc-469b-5018-a8d0-ca66e8aaca6a}">
      <Declaration><![CDATA[METHOD Disable]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF leftAxis = 0 OR rightAxis = 0 THEN
	RETURN;
END_IF
leftAxis.Disable();
rightAxis.Disable();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetTwist" Id="{098b0635-eb47-5c17-a9bd-67e37e18d5a2}">
      <Declaration><![CDATA[METHOD SetTwist
VAR_INPUT
	desiredTwist : Twist;
END_VAR
VAR
	speeds : WheelSpeeds;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF leftAxis = 0 OR rightAxis = 0 THEN
	RETURN;
END_IF
speeds := kinematics.ToWheelSpeeds(desiredTwist);
leftAxis.SetVelocity(speeds.leftInMPerS);
rightAxis.SetVelocity(speeds.rightInMPerS);]]></ST>
      </Implementation>
    </Method>
    <Property Name="LeftWheelPositionInM" Id="{bb529295-4fcf-568d-9617-282c57c2850a}">
      <Declaration><![CDATA[PROPERTY LeftWheelPositionInM : LREAL]]></Declaration>
      <Get Name="Get" Id="{2965df9d-c0ea-5ec0-abec-70f400e386ad}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF leftAxis <> 0 THEN
	LeftWheelPositionInM := leftAxis.PositionInM;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RightWheelPositionInM" Id="{e5a0aef1-afa7-5090-b787-bb6d4bf4debe}">
      <Declaration><![CDATA[PROPERTY RightWheelPositionInM : LREAL]]></Declaration>
      <Get Name="Get" Id="{063c88d4-001f-54bc-8702-a0373d496641}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF rightAxis <> 0 THEN
	RightWheelPositionInM := rightAxis.PositionInM;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsReady" Id="{0716dda0-318f-5c0b-9d2e-d407e343a688}">
      <Declaration><![CDATA[PROPERTY IsReady : BOOL]]></Declaration>
      <Get Name="Get" Id="{e8c996d9-55ee-583b-8f0d-bcac8b430915}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsReady := leftAxis <> 0 AND_THEN rightAxis <> 0 AND_THEN leftAxis.IsReady AND_THEN rightAxis.IsReady;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsStandingStill" Id="{9eaa38e4-969a-46e9-8447-5a679952e127}">
      <Declaration><![CDATA[PROPERTY IsStandingStill : BOOL]]></Declaration>
      <Get Name="Get" Id="{c6cf453b-3603-48b0-9504-ca7f6ef49e64}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsStandingStill := leftAxis <> 0 AND_THEN rightAxis <> 0 AND_THEN leftAxis.IsStandingStill AND_THEN rightAxis.IsStandingStill;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
