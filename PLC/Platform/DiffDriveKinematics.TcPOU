<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DiffDriveKinematics" Id="{79331de0-5a8b-57b6-bc0b-e22a30b63e2c}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'Use the methods of this class'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK DiffDriveKinematics]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ToBodyMotion" Id="{4216f1b7-dcf4-5184-ad60-bc9864ce41c2}">
      <Declaration><![CDATA[METHOD ToBodyMotion : BodyMotion
VAR_INPUT
	leftDeltaInM : LREAL;
	rightDeltaInM : LREAL;
END_VAR
VAR
	motion : BodyMotion;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[motion.distanceInM := (leftDeltaInM + rightDeltaInM) / 2.0;
motion.headingChangeInRad := (rightDeltaInM - leftDeltaInM) / Parameters.trackWidthInM;

ToBodyMotion := motion;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToWheelSpeeds" Id="{088634d7-9291-51c7-84cc-6014d4ff856d}">
      <Declaration><![CDATA[METHOD ToWheelSpeeds : WheelSpeeds
VAR_INPUT
	desiredTwist : Twist;
END_VAR
VAR
	speeds : WheelSpeeds;
	halfTrackInM : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[halfTrackInM := Parameters.trackWidthInM / 2.0;

speeds.leftInMPerS := desiredTwist.forwardSpeedInMPerS - desiredTwist.yawRateInRadPerS * halfTrackInM;
speeds.rightInMPerS := desiredTwist.forwardSpeedInMPerS + desiredTwist.yawRateInRadPerS * halfTrackInM;

ToWheelSpeeds := speeds;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>