{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@garage/sim-core": ["packages/sim-core/src/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src"]
}
